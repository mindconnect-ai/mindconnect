<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.mindconnect</groupId>
    <artifactId>mc-java-parent</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>mc-java-parent</name>
    <description>Lightweight parent for pure Java modules — no Spring, no framework</description>

    <!-- Project metadata required by Maven Central, inherited by every module. -->
    <url>https://github.com/mindconnect-ai/mindconnect</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>beisdog</id>
            <name>David Beisert</name>
            <organization>Mindconnect</organization>
            <organizationUrl>https://github.com/mindconnect-ai</organizationUrl>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/mindconnect-ai/mindconnect.git</connection>
        <developerConnection>scm:git:git@github.com:mindconnect-ai/mindconnect.git</developerConnection>
        <url>https://github.com/mindconnect-ai/mindconnect</url>
    </scm>

    <properties>
        <!-- Version of the published semantic-ui artifacts (their own repo:
             mindconnect-ai/mc-semantic-ui) consumed across the monorepo. -->
        <semantic-ui.version>0.2.2-SNAPSHOT</semantic-ui.version>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.40</lombok.version>
        <junit.version>5.10.3</junit.version>
        <assertj.version>3.26.3</assertj.version>
        <!-- Spring Boot is consumed as a BOM (version management only), not as a parent.
             Modules stay Spring-free unless they declare a Spring starter themselves. -->
        <spring-boot.version>3.5.13</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM: coordinated versions for anything a module chooses to use.
                 Imported (not inherited via parent) so this stays a plain Java parent.
                 Explicit entries below and in child parents override these. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <optional>true</optional>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!-- Emit method/constructor parameter names into the bytecode.
                             Spring needs these to resolve constructor injection by name
                             (spring-boot-starter-parent used to provide this). -->
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.3</version>
                </plugin>
                <!-- Managed here (version + repackage goal) so Spring Boot app modules can
                     declare the plugin without a version, exactly as under spring-boot-starter-parent. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!--
        Publishing goes to MAVEN CENTRAL via the Central Publisher Portal
        (https://central.sonatype.com). Activated with -Prelease on `mvn deploy`;
        a plain build never needs GPG or Central credentials.

        Prerequisites (one-time):
          1. Central Portal account with the namespace `ai.mindconnect` verified.
          2. A Portal user token, wired as a <server> with id "central" in
             settings.xml (CI: the release workflow does this from the org
             secrets CENTRAL_TOKEN_USERNAME / CENTRAL_TOKEN_PASSWORD).
          3. A GPG key pair for signing (CI: secrets MAVEN_GPG_PRIVATE_KEY /
             MAVEN_GPG_PASSPHRASE, imported by actions/setup-java).

        The central-publishing plugin replaces the default deploy: it stages,
        validates and uploads the whole reactor as one deployment. With
        autoPublish=false the deployment waits in the Portal for a manual
        "Publish" click — flip to true once the process is trusted.
        SNAPSHOTs are not published (Central hosts releases only).
    -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <!-- Non-interactive signing in CI. -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
