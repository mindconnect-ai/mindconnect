<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.mindconnect</groupId>
        <artifactId>mc-java-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
        <relativePath>../../mc-java-parent/pom.xml</relativePath>
    </parent>

    <artifactId>mc-taskqueue-demo-app</artifactId>
    <name>mc-taskqueue-demo-app</name>
    <packaging>jar</packaging>

    <description>
        Demo app for mc-task-queue: pick a task type, submit it with parameters,
        and watch tasks and channels live on a streaming board (semantic-ui SSE).
        Flagship task: crawl a website as a parent/child task tree, one page per
        child, each stored as Markdown via mc-webscraper's jsoup path.
    </description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-task-queue</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Only the jsoup scraper is used; playwright rides along transitively. -->
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-webscraper</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <!-- Boot brings logback; a second slf4j provider only warns. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-semantic-ui-core</artifactId>
            <version>${semantic-ui.version}</version>
        </dependency>
        <!-- UiJsonViewer for payload/state/failure on the task detail page -->
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-semantic-ui-ext-json</artifactId>
            <version>${semantic-ui.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Dev only: restart on recompile + LiveReload for static assets. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
