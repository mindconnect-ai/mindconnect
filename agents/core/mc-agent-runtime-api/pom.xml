<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.mindconnect</groupId>
        <artifactId>mc-agents-parent</artifactId>
        <version>${revision}${sha1}${changelist}</version>
        <relativePath>../../mc-agents-parent/pom.xml</relativePath>
    </parent>

    <artifactId>mc-agent-runtime-api</artifactId>
    <name>mc-agent-runtime-api</name>
    <packaging>jar</packaging>
    <description>
        The agent runtime's API and nothing else: the stateless services a
        program opens sessions and submits turns with, the ports agents,
        tools, the model and the session store sit behind, and the hook
        points capabilities attach to. Interfaces and values only, so that
        a tool or a capability depends on this module without pulling in
        the engine, the task queue or the LLM gateway.
    </description>

    <dependencies>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-agent-loop-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

</project>
