<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.mindconnect</groupId>
        <artifactId>mc-agents-parent</artifactId>
        <version>${revision}${sha1}${changelist}</version>
        <relativePath>../../mc-agents-parent/pom.xml</relativePath>
    </parent>

    <artifactId>mc-agent-chat-ui-rest</artifactId>
    <name>mc-agent-chat-ui-rest</name>
    <packaging>jar</packaging>
    <description>
        The chat UI — message list, composer, attachments and the streaming
        turn view, as UiNode-rendering components and the controllers that
        serve them. A library, like mc-agent-api-rest: no Spring Boot main
        class, so a host app decides how it is wired and secured.

        This is the lower of the two UI modules: the admin UI depends on it
        for its own chat page, not the other way round. A user-facing chat
        must not have to ship agent CRUD, LLM configs, traces and migrations.
    </description>

    <dependencies>

        <!-- Channel: the SSE bus's sequencing, replay buffer and fan-out.
             Reached transitively through the runtime today; named here because
             this module uses it directly. -->
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-task-queue</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Agent platform — domain types plus the REST controllers the UI drives -->
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-agent-api-rest</artifactId>
        </dependency>
        <!-- Semantic UI (from the standalone mc-semantic-ui repo) -->
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-semantic-ui-core</artifactId>
            <version>${semantic-ui.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-semantic-ui-ext-markdown</artifactId>
            <version>${semantic-ui.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-semantic-ui-ext-json</artifactId>
            <version>${semantic-ui.version}</version>
        </dependency>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- The UI controllers read the signed-in user via @AuthenticationPrincipal
             OidcUser; the OAuth flow itself is the host app's business. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
