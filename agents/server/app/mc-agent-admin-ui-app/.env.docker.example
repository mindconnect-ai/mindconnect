# Copy this file to .env.docker and fill in all values before running docker-compose.
# .env.docker is git-ignored and must never be committed.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change_me

# ── Keycloak Admin ────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me

# ── Seed User Passwords ───────────────────────────────────────────────────────
KC_PASSWORD_MC_USER=change_me
KC_PASSWORD_MC_ADMIN=change_me
KC_PASSWORD_MC_HR=change_me
KC_PASSWORD_MC_DEV=change_me
