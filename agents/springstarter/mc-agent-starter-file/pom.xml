<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.mindconnect</groupId>
        <artifactId>mc-agents-parent</artifactId>
        <version>${revision}${sha1}${changelist}</version>
        <relativePath>../../mc-agents-parent/pom.xml</relativePath>
    </parent>

    <artifactId>mc-agent-starter-file</artifactId>
    <name>mc-agent-starter-file</name>
    <packaging>jar</packaging>
    <description>
        Spring Boot starter for file persistence — the default: every repository
        port of the agent runtime, the message store, the LLM gateway and the
        file store on the file system under mindconnect.data.base-dir.
        Auto-configured; steps back for mindconnect.persistence=postgres.
    </description>

    <dependencies>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-agent-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-message-repository</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-llm-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-file-store</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>
