<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.mindconnect</groupId>
        <artifactId>mc-agents-parent</artifactId>
        <version>${revision}${sha1}${changelist}</version>
        <relativePath>../../mc-agents-parent/pom.xml</relativePath>
    </parent>

    <artifactId>mc-agent-starter-postgres</artifactId>
    <name>mc-agent-starter-postgres</name>
    <packaging>jar</packaging>
    <description>
        Spring Boot starter for Postgres persistence: with
        mindconnect.persistence=postgres every repository port of the agent
        runtime, the message store, the LLM gateway and the file store is served
        by its Postgres adapter over one pooled DataSource, and the tables are
        created on start. Auto-configured — on the classpath is enough.
    </description>

    <dependencies>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-agent-runtime-pg</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-message-repository-pg</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-llm-gateway-pg</artifactId>
        </dependency>
        <!-- EncryptingLlmConfigRepository, the decorator both stores wear -->
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-llm-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-file-store-pg</artifactId>
        </dependency>
        <!-- the SPI and the filesystem backend, for mindconnect.file-store.backend=filesystem under Postgres -->
        <dependency>
            <groupId>ai.mindconnect</groupId>
            <artifactId>mc-file-store</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>
