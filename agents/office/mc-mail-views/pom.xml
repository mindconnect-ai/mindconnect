        <artifactId>mc-agents-parent</artifactId>
        <version>${revision}${sha1}${changelist}</version>
        <relativePath>../../mc-agents-parent/pom.xml</relativePath>
    </parent>

    <artifactId>mc-mail-views</artifactId>
    <name>mc-mail-views</name>
    <packaging>jar</packaging>
    <description>
        A list of mail as a thing with an identity: MailListView, the interface
        a folder, all inboxes, and what an agent gathered all implement; the
        state that goes with a view (selection, search, page) and survives
        with it; and a file and a Postgres store for the views that are kept.
    </description>

