# Copy to mc.env and fill in. mc.env is git-ignored; after-branch-creation.sh copies it from the main checkout.
# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_HOST=
PINECONE_INDEX=
PINECONE_NAMESPACE=
# ── Exa AI Search ─────────────────────────────────────────────────────────────
EXA_API_KEY=
# ── Keycloak OIDC ─────────────────────────────────────────────────────────────
KC_ISSUER_URI=
KC_CLIENT_ID=
KC_SCOPE=
# ── Tavily Web Search ─────────────────────────────────────────────────────────
TAVILY_API_KEY=
GITHUB_TOKEN=
DB_CLIENT_ID=
DB_API_KEY=
# ---- EMAIL
MC_MICROSOFT_CLIENT_ID=
MC_GOOGLE_CLIENT_ID=
MC_GOOGLE_CLIENT_SECRET=
# ---- OTHER
MINDCONNECT_ENCRYPTION_SECRET_KEY=
OPENAI_EMBEDDING_API_KEY=
# ── Test Environment ─────────────────────────────────────────────────────────
TEST_LLM_MODEL=
TEST_LLM_API_KEY=
TEST_EMBEDDING_MODEL=
TEST_EMBEDDING_API_KEY=
#Just for responses tests
TEST_OPENAI=
TEST_OPENAI_MODEL=
# ── Persistence ───────────────────────────────────────────────────────────────
# file (default): everything under mindconnect.data.base-dir.
# postgres: every repository in the database, tables created on start —
# e.g. podman run -d -p 5433:5432 -e POSTGRES_PASSWORD=test pgvector/pgvector:pg17-trixie
MC_PERSISTENCE=
MC_POSTGRES_URL=
MC_POSTGRES_USER=
MC_POSTGRES_PASSWORD=
